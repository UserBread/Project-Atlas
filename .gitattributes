# ---------------------------------------------------------
# General text normalization (LF in repo)
# ---------------------------------------------------------
* text=auto eol=lf

# ---------------------------------------------------------
# Unity text-based assets
# ---------------------------------------------------------
*.unity       text eol=lf
*.prefab      text eol=lf
*.asset       text eol=lf
*.meta        text eol=lf
*.asmdef      text eol=lf
*.asmref      text eol=lf
*.cs          text eol=lf
*.shader      text eol=lf
*.cginc       text eol=lf
*.hlsl        text eol=lf
*.compute     text eol=lf
*.uxml        text eol=lf
*.uss         text eol=lf
*.json        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.xml         text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf

# Input System and Timeline assets
*.inputactions text eol=lf
*.playable     text eol=lf
*.timeline     text eol=lf
*.vfx          text eol=lf
*.overrideController text eol=lf

# ---------------------------------------------------------
# Treat binary assets explicitly as binary
# ---------------------------------------------------------
*.png          binary
*.jpg          binary
*.jpeg         binary
*.tga          binary
*.gif          binary
*.bmp          binary
*.psd          binary
*.tif          binary
*.tiff         binary
*.exr          binary

*.mp3          binary
*.ogg          binary
*.wav          binary

*.fbx          binary
*.obj          binary
*.blend        binary
*.dae          binary
*.unitypackage binary

# 3D / physics assets
*.physicMaterial binary
*.mesh          binary

# ---------------------------------------------------------
# Unity package manager and project settings
# ---------------------------------------------------------
ProjectSettings/*              text eol=lf
Packages/manifest.json         text eol=lf
Packages/packages-lock.json    text eol=lf

# ---------------------------------------------------------
# Prevent accidental EOL conversion for compiled libraries
# ---------------------------------------------------------
*.dll          binary
*.exe          binary
*.so           binary
*.dylib        binary
*.a            binary
*.lib          binary
